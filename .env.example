# ---- Backend API (server-side only; never exposed to the browser) ----
# The deployed Courier & Logistics API (must include /api/v1)
API_URL="https://courier-logistics-platform.onrender.com/api/v1"

# ---- Stripe (publishable key only - safe for the browser) ----
# Must be the test-mode publishable key (pk_test_...) from the SAME Stripe
# account/sandbox as the backend's STRIPE_SECRET_KEY.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# ---- Optional ----
# If set to the backend's JWT_ACCESS_SECRET, middleware verifies token
# signatures locally (defence in depth). Leave blank to decode-only; the
# backend still enforces authorization on every request either way.
JWT_ACCESS_SECRET=""

# Public site URL used for metadata / sitemap (Vercel sets a default automatically)
NEXT_PUBLIC_SITE_URL=""

# Address the contact form opens a mail draft to
NEXT_PUBLIC_CONTACT_EMAIL="pritomofficial00@gmail.com"
